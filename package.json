{
  "name": "autopilot-rally",
  "version": "0.1.0",
  "private": true,
  "description": "University club racing game with a local SQLite leaderboard",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "test": "node --test",
    "db:import": "node --env-file-if-exists=.env scripts/import-json.js"
  }
}
